{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nightreign Launcher",
  "version": "1.1.2",
  "identifier": "local.nightreign.updater",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Nightreign Launcher",
      "width": 1120,
      "height": 780,
      "minWidth": 780,
      "minHeight": 580,
      "decorations": false,
      "center": true,
      "theme": "Dark",
      "backgroundColor": "#0b0e16"
    }],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
